# ─────────────────────────────────────────────────────────────
# GOCAS Landing · variables de entorno
# Copia este archivo a `.env.local` y rellena los valores reales.
# `.env.local` está en .gitignore — NUNCA lo subas al repo.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (para canonical / OG / metadataBase).
NEXT_PUBLIC_SITE_URL=https://gocas.co

# ── Supabase ───────────────────────────────────────────────────
# Project ID: hvyxtdmntwledjpsonac · región us-east-2
NEXT_PUBLIC_SUPABASE_URL=https://hvyxtdmntwledjpsonac.supabase.co
# Anon key (PÚBLICA · seguro exponerla — usada por el login del portal con RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (SECRETO · solo servidor — da acceso total, nunca exponer en el cliente).
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (notificación de leads por email) ───────────────────
# Opcional: si no se define, el lead igual se guarda en Supabase pero no se envía email.
RESEND_API_KEY=
# Email que recibe la notificación de cada lead nuevo.
CONTACT_EMAIL=hola@gocas.co

# ── WhatsApp (botón de contacto directo) ───────────────────────
# Número en formato internacional sin '+' ni espacios. Ej: 573001112233
NEXT_PUBLIC_WHATSAPP_NUMBER=573000000000
